# Optional application settings. Do not put secrets in frontend files.
APP_NAME=Teddy – Smart AI Analyst
ENVIRONMENT=development
DEBUG=false
MAX_UPLOAD_SIZE_MB=10
DOCUMENT_TTL_MINUTES=30
MAX_PDF_PAGES=200
MAX_TABLE_ROWS=1000
MAX_EXTRACTED_CHARS=1000000
MAX_CONCURRENT_DOCUMENTS=2
MAX_CONCURRENT_AI_REQUESTS=2
# AI is disabled unless a provider is explicitly selected and its free-access
# eligibility is confirmed for the exact account, model, and endpoint.
ALLOW_PAID_APIS=false
AI_PROVIDER=none
AI_REQUEST_TIMEOUT_SECONDS=30
# At most one retry, and only for connection-establishment failures. Provider
# responses, timeouts after send, auth, quota, billing, and payment errors stop.
AI_MAX_RETRIES=1
AGENT_MAX_STEPS=8
AGENT_TIMEOUT_SECONDS=60
AI_MAX_OUTPUT_CHARS=16000
# Optional; defaults to the operating system temporary directory / teddy-uploads.
# UPLOAD_TEMP_DIR=D:/teddy-temp

# NVIDIA NIM remains disabled until you have independently confirmed genuinely
# free developer API access for this exact model and endpoint. A model name or
# access to a consumer app/playground is not proof of free API access.
NVIDIA_NIM_FREE_ACCESS_CONFIRMED=false
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=
NVIDIA_NIM_TEMPERATURE=0.2
NVIDIA_NIM_TOP_P=0.7
AI_MAX_OUTPUT_TOKENS=1800

# Optional xAI API adapter. It is hard-disabled unless both flags are explicitly
# enabled after confirming genuinely free API access on the account. Consumer
# Grok app/playground access does not qualify. No billing or paid fallback exists.
ENABLE_GROK=false
GROK_FREE_API_ACCESS_CONFIRMED=false
XAI_API_KEY=
XAI_MODEL=
XAI_BASE_URL=

# These flags are safety gates, not live billing/quota checks. Provider pricing,
# account eligibility, and remaining free quota must be verified separately.
MAX_AI_INPUT_CHARS=48000
AI_CHUNK_CHARS=8000
MAX_AI_CHUNKS=6
CHAT_CHUNK_CHARS=1200
CHAT_CHUNK_OVERLAP_CHARS=120
CHAT_MAX_CHUNKS=1200
CHAT_RETRIEVAL_TOP_K=5
CHAT_MAX_CONTEXT_CHARS=9000
CHAT_MAX_QUESTION_CHARS=1000
CHAT_HISTORY_TURNS=4
CHAT_HISTORY_MAX_CHARS=6000
